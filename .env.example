# Contact form API endpoint (optional)
NEXT_PUBLIC_CONTACT_API_URL=

# Public marketing/site URL (no trailing slash). Local preview may be localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# test = QNB 3D Host test gateway (vpostest). production = live vpos.qnb.com.tr
# QNB_ENV is an alias of PAYMENT_ENV. Never mix test credentials with production endpoints.
QNB_ENV=test
PAYMENT_ENV=test
# QNB OkUrl/FailUrl. Remote bank tests require a public HTTPS origin, not localhost.
# Example: https://www.ticketgoteknoloji.com
PAYMENT_PUBLIC_BASE_URL=
# Optional VAT override (0.2 or 20). Default: 20% KDV from src/config/vat.ts
PAYMENT_VAT_RATE=
PAYMENT_SIGNING_SECRET=
PAYMENT_ALLOWED_ORIGINS=
PAYMENT_ADMIN_KEY=

# QNBpay / QNB Sanal POS (PayFor 3D Host)
QNBPAY_ENABLED=true
QNBPAY_BASE_URL=
# 3D Host form POST. Empty = official vpostest/vpos .../Gateway/3DHost.aspx
QNBPAY_GATEWAY_URL=
# NonSecure/XML API. Empty = official .../Gateway/Default.aspx
QNBPAY_API_URL=
QNBPAY_SIPAY_BASE_URL=

# QNB PayFor / 3D Host (official vpos.qnb.com.tr)
QNBPAY_MERCHANT_ID=
QNBPAY_USER_CODE=
QNBPAY_PASSWORD=
QNBPAY_STORE_KEY=
QNBPAY_MBR_ID=

# QNBpay Sipay hosted link fallback (official apidocs.sipay.com.tr)
QNBPAY_APP_ID=
QNBPAY_APP_SECRET=
QNBPAY_MERCHANT_KEY=

# Merchant-confirmed card programs only. Default is off.
# QNBPAY_PROGRAM_QNB=true
# QNBPAY_PROGRAM_BONUS=true
# QNBPAY_PROGRAM_WORLD=true
# QNBPAY_PROGRAM_PARAF=true
# QNBPAY_PROGRAM_AXESS=true
# QNBPAY_PROGRAM_MAXIMUM=true
# QNBPAY_INSTALLMENTS=1,3,6
# QNBPAY_PROGRAM_BONUS_INSTALLMENTS=1,3,6
