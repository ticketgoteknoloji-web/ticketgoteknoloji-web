# Public marketing/site URL (no trailing slash). Production must be https://www.ticketgoteknoloji.com
NEXT_PUBLIC_SITE_URL=https://www.ticketgoteknoloji.com

# Local app origin for payment callbacks and TCMB-backed checkout (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Contact form API endpoint (optional external webhook)
NEXT_PUBLIC_CONTACT_API_URL=

# Download Center admin (server-side only — never commit plaintext codes or real hashes)
# Generate with: node scripts/hash-download-admin-code.mjs
DOWNLOAD_ADMIN_CODE_HASH=
DOWNLOAD_ADMIN_SESSION_SECRET=
DOWNLOAD_SESSION_SECRET=
# Production: /srv/ticketgoteknoloji/downloads
DOWNLOAD_STORAGE_DIR=
# Absolute path for downloads.json, outside the release directory.
# Empty keeps <cwd>/.data/downloads.json.
DOWNLOAD_DATA_FILE=
DOWNLOAD_MAX_FILE_SIZE_MB=2048
# Client-side upload UI limit (keep in sync with DOWNLOAD_MAX_FILE_SIZE_MB)
NEXT_PUBLIC_DOWNLOAD_MAX_FILE_SIZE_MB=2048

# test = sandbox/test gateways. production = live endpoints.
# Never mix test credentials with production endpoints.
PAYMENT_ENV=test
# QNB OkUrl/FailUrl. Remote bank tests require a public HTTPS origin, not localhost.
PAYMENT_PUBLIC_BASE_URL=
PAYMENT_VAT_RATE=
PAYMENT_SIGNING_SECRET=
PAYMENT_ALLOWED_ORIGINS=
PAYMENT_ADMIN_KEY=
# Absolute path for payments.json, outside the release directory.
# Empty keeps <cwd>/.data/payments.json. A relative path is rejected.
PAYMENT_ORDERS_FILE=

# Tami / Garanti BBVA Sanal POS (primary)
# sandbox → https://sandbox-paymentapi.tami.com.tr
# production → https://paymentapi.tami.com.tr
# Portal credentials (İş Yerim → POS Yetkileri). Never commit real values.
# TAMI_MERCHANT_ID = Üye iş yeri numarası
# TAMI_POS_ID = Terminal numarası. Boşsa ve TAMI_TERMINAL_ID gerçekse o kullanılır.
# TAMI_USERNAME veya TAMI_KID = Kid (JWT kid)
# TAMI_PASSWORD veya TAMI_K = K (JWK k). kid|k biçimi de kabul edilir.
# TAMI_SECRET_KEY = Secure Key (PG-Auth-Token ve 3DS hashedData)
# Tahsilat, banka canlı satış yetkisi ve yenilenmiş anahtarlar sunucuya konmadan kapalı kalır.
TAMI_ENV=sandbox
TAMI_ENABLED=false
TAMI_SANDBOX_BASE_URL=https://sandbox-paymentapi.tami.com.tr
TAMI_PRODUCTION_BASE_URL=https://paymentapi.tami.com.tr
TAMI_MERCHANT_ID=
TAMI_POS_ID=
TAMI_USERNAME=
TAMI_PASSWORD=
TAMI_SECRET_KEY=
TAMI_CALLBACK_URL=http://localhost:3001/api/payments/tami/callback

# Legacy QNBpay / QNB Sanal POS (disabled by default; kept for old orders)
QNBPAY_ENABLED=false
QNB_ENV=test
QNBPAY_BASE_URL=
QNBPAY_GATEWAY_URL=
QNBPAY_API_URL=
QNBPAY_SIPAY_BASE_URL=

# QNB PayFor / 3D Host
QNBPAY_MERCHANT_ID=
QNBPAY_USER_CODE=
QNBPAY_PASSWORD=
QNBPAY_STORE_KEY=
QNBPAY_MBR_ID=

# QNBpay Sipay hosted link fallback
QNBPAY_APP_ID=
QNBPAY_APP_SECRET=
QNBPAY_MERCHANT_KEY=
