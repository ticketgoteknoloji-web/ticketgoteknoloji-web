# Public marketing/site URL (no trailing slash). Production must be https://www.ticketgoteknoloji.com
NEXT_PUBLIC_SITE_URL=https://www.ticketgoteknoloji.com

# Contact form API endpoint (optional external webhook)
NEXT_PUBLIC_CONTACT_API_URL=

# Download Center admin (server-side only — never commit plaintext passwords or real hashes)
DOWNLOAD_ADMIN_EMAIL=
DOWNLOAD_ADMIN_PASSWORD_HASH=
DOWNLOAD_ADMIN_SESSION_SECRET=
DOWNLOAD_SESSION_SECRET=
# Production: /srv/ticketgoteknoloji/downloads
DOWNLOAD_STORAGE_DIR=
DOWNLOAD_MAX_FILE_SIZE_MB=2048

# test = QNB 3D Host test gateway (vpostest). production = live vpos.qnb.com.tr
# QNB_ENV is an alias of PAYMENT_ENV. Never mix test credentials with production endpoints.
QNB_ENV=test
PAYMENT_ENV=test
# QNB OkUrl/FailUrl. Remote bank tests require a public HTTPS origin, not localhost.
PAYMENT_PUBLIC_BASE_URL=
PAYMENT_VAT_RATE=
PAYMENT_SIGNING_SECRET=
PAYMENT_ALLOWED_ORIGINS=
PAYMENT_ADMIN_KEY=

# QNBpay / QNB Sanal POS (PayFor 3D Host)
QNBPAY_ENABLED=true
QNBPAY_BASE_URL=
QNBPAY_GATEWAY_URL=
QNBPAY_API_URL=
QNBPAY_SIPAY_BASE_URL=

# QNB PayFor / 3D Host
QNBPAY_MERCHANT_ID=
QNBPAY_USER_CODE=
QNBPAY_PASSWORD=
QNBPAY_STORE_KEY=
QNBPAY_MBR_ID=

# QNBpay Sipay hosted link fallback
QNBPAY_APP_ID=
QNBPAY_APP_SECRET=
QNBPAY_MERCHANT_KEY=
