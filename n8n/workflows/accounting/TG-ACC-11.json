      "parameters": {
        "jsCode": "const j = $json;\nif (j.pullFromBank === true) throw Object.assign(new Error('VALIDATION_NO_RETRY'), { noRetry: true, code: 'BANK_PROVIDER_NOT_CONFIGURED' });\nconst body = { bankAccountId: j.bankAccountId, amountMinor: j.amountMinor, currency: j.currency || 'TRY', bookedAt: j.bookedAt, reference: j.reference, counterIban: j.counterIban, idempotencyKey: j.idempotencyKey || j.reference };\nreturn [{ json: { idempotencyKey: body.idempotencyKey, body } }];"
      },
